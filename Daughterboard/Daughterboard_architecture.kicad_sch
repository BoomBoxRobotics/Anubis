		(exclude_from_sim no)
		(at 152 15 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "97c0be66-ea76-45a1-9ccf-47f26949be9b")
	)
	(text "CTRL_3V3_SW"
		(exclude_from_sim no)
		(at 152 130 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "5fc64341-cd0f-4608-a204-11298368e1e2")
	)
	(text "Design limits:\n- Charge current: 1.5 A max\n- 5 V rail: 1 A max\n- 3.3 V rail: 500 mA max\n- Full-load battery current estimate at 3.3 V pack: about 2.24 A plus transients\n- Use matched, voltage-balanced 18650 cells only"
		(exclude_from_sim no)
		(at 25 172 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "62128605-7a18-4d36-9e76-ed56ed692745")
	)
	(text "USB-C note: plain 5.1k CC pulldowns make this a 5 V sink. For fixed 1.5 A input current, use a capable USB-C adapter,\nadd a 500 mA / 1.5 A selector, or add Type-C current-detect/PD circuitry before drawing adapter-level current."
		(exclude_from_sim no)
		(at 25 202 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "d33c1706-7275-4064-a4ec-b1f14414094b")
	)
	(text "Output power switching: Pololu #2808 modules sit after the regulators. ESP32 GPIOs pulse CTRL high to turn on,\npulse CTRL low to turn off, then return to input/high-Z. Suggested pins: GPIO2 for 5 V, GPIO3 for 3.3 V."
		(exclude_from_sim no)
		(at 25 220 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "547038e8-f9d4-4eef-be0c-cda32fab7f2a")
	)
